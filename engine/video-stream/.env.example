# exnestjs-elysia — contoh env host app untuk @exnest/video-engine
# Salin ke `.env` project host; hanya key VIDEO_* yang dikonsumsi video engine,
# sisanya (APP_NAME, DATABASE_URL, PORT, API_BASE_URL) milik framework host.
APP_NAME="exnest-elysia"
DATABASE_URL="postgresql://user:password@localhost:5432/exnest_ts"
PORT=3000
API_BASE_URL="http://localhost:3000"
NODE_ENV="development"
JWT_SECRET="super-secret-key-change-in-production"

# video-engine
VIDEO_STORAGE_DIR="./uploads"
VIDEO_FFMPEG_BIN="ffmpeg"
VIDEO_MAX_BYTES=2147483648
VIDEO_PROCESS_SLOTS=1            # N = N ffmpeg paralel (default 1)
VIDEO_MAX_QUEUE=5                # ingress cap sebelum ditolak 429
VIDEO_SIGNED_SECRET="super-secret-video-sign-key-change-in-production"
VIDEO_SIGNED_TTL_SECONDS=1800
VIDEO_API_KEY="change-me"
VIDEO_CORS_ORIGIN="*"
VIDEO_PROXY_TIMEOUT_MS=30000
VIDEO_RENDITIONS=3               # 3 = 1080p/720p/480p, 2 = 720p/480p
VIDEO_KEEP_SOURCE="true"         # "true" simpan file source, "false" hapus setelah HLS jadi
VIDEO_YOUTUBE_BIN=""             # yt-dlp path (kosong = auto-detect); wajib untuk URL YouTube