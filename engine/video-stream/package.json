{
  "name": "@exnest/video-engine",
  "version": "0.1.0",
  "description": "Universal HLS video streaming machine for the exnest ecosystem — zero-dep core, pluggable adapters (Elysia + NestJS), installable from both Bun and npm. Upload a file or give it a URL (Google Drive & YouTube included) and get adaptive-bitrate HLS back.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "default": "./dist/nest.js"
    },
    "./elysia": {
      "types": "./dist/elysia.d.ts",
      "import": "./dist/elysia.js",
      "default": "./dist/elysia.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@nestjs/common": ">=8 <12",
    "elysia": ">=1.4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "elysia": {
      "optional": true
    }
  },
  "dependencies": {
    "youtube-dl-exec": "^3.1.4"
  },
  "trustedDependencies": [
    "youtube-dl-exec"
  ],
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^11.2.1",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.14",
    "elysia": "^1.4.24",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  }
}