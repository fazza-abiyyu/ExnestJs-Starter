# @exnest/pdf-engine — contoh env host app
# Salin ke `.env` project host; hanya key PDF_* yang dikonsumsi pdf engine,
# sisanya (APP_NAME, DATABASE_URL, PORT, API_BASE_URL) milik framework host.
APP_NAME="exnest-elysia"
DATABASE_URL="postgresql://user:password@localhost:5432/exnest_ts"
PORT=3000
API_BASE_URL="http://localhost:3000"
NODE_ENV="development"
JWT_SECRET="super-secret-key-change-in-production"

# pdf-engine
PDF_STORAGE_DIR="./storage"        # folder dasar: storage/docs/{id}/{source,pages}
PDF_SIGNED_SECRET="super-secret-pdf-sign-key-change-in-production"
PDF_SIGNED_TTL_SECONDS=300         # masa berlaku token halaman + cookie sesi viewer
PDF_MAX_BYTES=52428800             # cap ukuran PDF per ingest (50 MB)
PDF_PROCESS_SLOTS=1                # N = N rasterizer paralel (default 1)
PDF_MAX_QUEUE=5                    # ingress cap sebelum ditolak 429
PDF_PROXY_TIMEOUT_MS=30000         # timeout fetch per-hop Google Drive
PDF_RASTER_SCALE=1.5               # resolusi rasterisasi (1 = 72dpi, 1.5 = 108dpi)
PDF_API_KEY="change-me"            # x-api-key untuk create/list/delete
PDF_CORS_ORIGIN="*"