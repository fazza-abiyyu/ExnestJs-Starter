{
  "name": "@exnest/pdf-engine",
  "version": "0.1.0",
  "description": "Universal PDF streaming machine for the exnest ecosystem — zero-dep kernel, pluggable adapters (Elysia + NestJS), installable from both Bun and npm. Upload a PDF or give it a Google Drive link and get token-gated, rasterized, watermarked pages back.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "default": "./dist/nest.js"
    },
    "./elysia": {
      "types": "./dist/elysia.d.ts",
      "import": "./dist/elysia.js",
      "default": "./dist/elysia.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@nestjs/common": ">=8 <12",
    "elysia": ">=1.4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "elysia": {
      "optional": true
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^11.2.1",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.14",
    "elysia": "^1.4.24",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  }
}