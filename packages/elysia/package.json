{
  "name": "exnest-ts",
  "version": "0.0.1",
  "description": "ExnestTs - ElysiaJs — Elysia + Bun framework following the Exnest modular style",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test ./test/*.e2e-spec.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "gen:module": "bun run scripts/generate-module.ts",
    "openapi:gen": "bun run scripts/generate-openapi.ts",
    "postman:gen": "bun run scripts/generate-postman.ts",
    "va:generate": "bun run ../../engine/va-orm/packages/cli/bin/va.ts generate",
    "va:migrate": "bun run ../../engine/va-orm/packages/cli/bin/va.ts migrate",
    "va:push": "bun run ../../engine/va-orm/packages/cli/bin/va.ts push",
    "va:pull": "bun run ../../engine/va-orm/packages/cli/bin/va.ts pull"
  },
  "dependencies": {
    "@v-va/orm": "file:../../engine/va-orm",
    "elysia": "^1.4.29",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
