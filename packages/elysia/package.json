{
  "name": "exnest-ts",
  "version": "0.0.1",
  "description": "ExnestTs - ElysiaJs — Elysia + Bun framework following the Exnest modular style",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "test:e2e": "bun test test/e2e.spec.ts",
    "typecheck": "bunx tsc --noEmit",
    "gen:module": "bun run scripts/generate-module.ts",
    "openapi:gen": "bun run scripts/generate-openapi.ts",
    "postman:gen": "bun run scripts/generate-postman.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "elysia": "^1.4.29",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "prisma": "^7.8.0"
  }
}